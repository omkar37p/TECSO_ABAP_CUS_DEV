projection;
strict ( 1 );
use draft;

define behavior for ZJV_POST_PV //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use action Payroll;
  use action Accdoc;

  use action Resume;
  use action Edit;
  use action Activate;
  use action Discard;
  use action Prepare;


  use association _Item { create; with draft; }
}

define behavior for ZJV_POST1_PV //alias <alias_name>
{
  use update;
  use delete;

  use association _Header { with draft; }
}