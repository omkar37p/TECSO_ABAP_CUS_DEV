@Metadata.layer: #PARTNER
@UI: { headerInfo: {
typeName: 'JV POST',
typeNamePlural: 'JV POST'
         } }
annotate entity ZJV_POST_PV
    with 
{
@UI.facet: [ { id:              'Header',
                      purpose:         #STANDARD,
                      type:            #IDENTIFICATION_REFERENCE,
                      label:           'HR JV POSTING',
                      position:        10 } ,
                    { id:              'Items',
                      purpose:         #STANDARD,
                      type:            #LINEITEM_REFERENCE,
                      label:           'Company',
                      position:        20,
                     targetElement:   '_Item'}]
    @UI.hidden: true
    Uuid;
    @UI:{ lineItem: [{ position:160 , label: 'Month'  }],
  identification: [{ position: 160 , label: 'Month' },{ type: #FOR_ACTION , dataAction: 'Payroll',label: 'Payroll JV',position: 10 },
                                                      { type: #FOR_ACTION , dataAction: 'Accdoc',label: 'Accdoc JV',position: 20 }] }
  @EndUserText.label: 'Month'
    Zmonth;
    @UI:{ lineItem: [{ position:170 , label: 'Year'  }],
  identification: [{ position: 170 , label: 'Year' }] }
  @EndUserText.label: 'Year'
    Zyears;
    @UI: {
  lineItem: [{ position: 10, label: 'JV Name' }],
  identification: [{ position: 10, label: 'JV Name' }]}
    Jvname;
    @UI:{ lineItem: [{ position:20 , label: 'Company Code'  }] ,
  identification: [{ position: 20 , label: 'Company Code' }]}
  @EndUserText.label: 'Company Code'
//  @Consumption.valueHelpDefinition: [{ entity:{ name: 'ZHR_CC_VH1', element: 'CompanyCode' },
//            additionalBinding: [{ localElement: 'CompanyCodeName', 
//                                   element: 'CompanyCodeName',
//                                   usage: #RESULT }] }]
    Companycode;
    
    @UI:{ lineItem: [{ position:40 , label: ' Designation Name'  }],
  identification: [{ position: 40 , label: ' Designation Name' }] }
  Designationname;
  @UI:{ lineItem: [{ position:180 , label: 'Grade Name'  }],
  identification: [{ position: 180 , label: 'Grade Name' }] }
  Gradename;
  @UI:{ lineItem: [{ position:50 , label: 'Department Name'  }],
  identification: [{ position: 50 , label: 'Department Name' }] }
  Departmentname;
  @UI:{ lineItem: [{ position:60 , label: 'Sub Department Name'  }],
  identification: [{ position: 60 , label: 'Sub Department Name' }] }
  Subdepartmentname;
  @UI:{ lineItem: [{ position:70 , label: 'Level Name'  }],
  identification: [{ position: 70 , label: 'Level Name' }] }
  Levelname;
  @UI:{ lineItem: [{ position:80 , label: 'Region Name'  }],
  identification: [{ position: 80 , label: 'Region Name' }] }
  Regionname;
  @UI:{ lineItem: [{ position:90 , label: 'Branch Name'  }],
  identification: [{ position: 90 , label: 'Branch Name' }] }
  Branchname;
  @UI:{ lineItem: [{ position:100 , label: 'Sub Branch Name'  }],
  identification: [{ position: 100 , label: 'Sub Branch Name' }] }
  Subbranchname;
  @UI:{ lineItem: [{ position:110 , label: 'Employee Type Name'  }],
  identification: [{ position: 110 , label: 'Employee Type Name' }] }
  Employeetypename;
  @UI:{ lineItem: [{ position:120 , label: 'Employee Status Name'  }],
  identification: [{ position: 120 , label: 'Employee Status Name' }] }
  Employeestatusname;
  @UI:{ lineItem: [{ position:130 , label: 'Business Unit Name'  }],
  identification: [{ position: 130 , label: 'Business Unit Name' }] }
  Businessunitname;
  @UI:{ lineItem: [{ position:140 , label: 'Employee Other Type Name'  }],
  identification: [{ position: 140 , label: 'Employee Other Type Name' }] }
  Employeeotherstatusname;
  @UI:{ lineItem: [{ position:150 , label: 'Format Type'  }],
  identification: [{ position: 150 , label: 'Format Type' }] }
  Formattype;
  @UI.hidden: true
  Lastchangedby;
  @UI.hidden: true
  Lastchangedat;
  @UI.hidden: true
  Locallastchanged;
  @UI:{ lineItem: [{ position:180 , label: 'Createdby'  }],
  identification: [{ position: 180 , label: 'Createdby' }] }
  Createdby;
  @UI:{ lineItem: [{ position:190 , label: 'Createdate'  }],
  identification: [{ position: 190 , label: 'Createdate' }] }
  Createdate;
  @UI:{ lineItem: [{ position:30 , label: 'Company Code Name'  }],
  identification: [{ position: 30 , label: 'Company Code Name' }] }

  Companycodename;
  @UI.hidden: true
//  @UI:{ lineItem: [{ position:200 , label: 'Checkbox'  }],
//  identification: [{ position: 200 , label: 'Checkbox' }] }
  Checkbox;
  @UI.hidden: true
  /* Associations */
  _Item;
    
}