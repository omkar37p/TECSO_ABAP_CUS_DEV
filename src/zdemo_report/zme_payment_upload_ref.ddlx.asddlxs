    targetElement:'CompanyCode' } ]

  @UI: {  lineItem:       [ { position: 10, label: 'Company Code' } ],
    identification: [ { position: 10, label: 'Company Code' } ],
    selectionField: [ { position: 10}  ]}
  CompanyCode;
  @UI: {  lineItem:       [ { position: 20, label: 'GL Account' } ],
     identification: [ { position: 20, label: 'GL Account' } ],
     selectionField: [ { position: 20}  ]}
  GLAccount;
  @UI: {  lineItem:       [ { position: 30, label: 'Company Code Name' } ],
     identification: [ { position: 30, label: 'Company Code Name' } ] }
  CompanyCodeName;
  @UI: {  lineItem:       [ { position: 40, label: 'Currency' } ],
     identification: [ { position: 40, label: 'Currency' } ] }
  Currency;
  @UI: {  lineItem:       [ { position: 50, label: 'GL Account Name' } ],
